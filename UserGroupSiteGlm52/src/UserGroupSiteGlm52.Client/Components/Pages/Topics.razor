@page "/topics"
@rendermode InteractiveWebAssembly
@attribute [Authorize]

<h1 class="mb-3">Topic suggestions</h1>
<p class="text-muted">Suggest a talk topic, vote for the ones you want to see, and volunteer to present.</p>

<section class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5 card-title">Suggest a topic</h2>
        <EditForm Model="NewTopic" OnValidSubmit="Suggest" novalidate>
            <DataAnnotationsValidator />
            <div class="form-floating mb-3">
                <InputText id="topicTitle" class="form-control" placeholder="Title" @bind-Value="NewTopic.Title" />
                <label for="topicTitle">Title</label>
                <ValidationMessage For="@(() => NewTopic.Title)" class="text-danger small" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Description (optional, Markdown)</label>
                <MarkdownEditor @bind-Value="NewTopic.Description" Id="topicDescription" Label="Description" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@suggesting">
                @if (suggesting)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span class="bi bi-lightbulb me-1" aria-hidden="true"></span>
                }
                Suggest topic
            </button>
        </EditForm>
    </div>
</section>

<h2 class="h5 mb-3">All topics</h2>

@if (TopicList is null)
{
    <p class="text-muted">Loading…</p>
}
else if (TopicList.Count == 0)
{
    <p class="text-muted">No topics yet — be the first to suggest one.</p>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var topic in TopicList)
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h3 class="card-title h6 mb-1">@topic.Title</h3>
                        <span class="badge bg-secondary">
                            <span class="bi bi-hand-thumbs-up me-1" aria-hidden="true"></span>@topic.VoteCount
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(topic.Description))
                    {
                        <pre class="bg-light p-2 rounded small mb-2" style="white-space: pre-wrap;">@topic.Description</pre>
                    }

                    <p class="card-text small text-muted mb-2">Suggested by @topic.SuggestedByName</p>

                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button type="button"
                                class="btn btn-sm @(topic.HasCurrentUserVoted ? "btn-success" : "btn-outline-success")"
                                @onclick="() => VoteAsync(topic)">
                            <span class="bi @(topic.HasCurrentUserVoted ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-up") me-1" aria-hidden="true"></span>
                            @(topic.HasCurrentUserVoted ? "Voted" : "Vote")
                        </button>

                        @if (topic.HasCurrentUserVolunteered)
                        {
                            <span class="badge bg-primary">
                                <span class="bi bi-megaphone-fill me-1" aria-hidden="true"></span>You volunteered
                            </span>
                        }
                        else if (topic.VolunteerName is not null)
                        {
                            <span class="text-muted small">
                                <span class="bi bi-person-check me-1" aria-hidden="true"></span>@topic.VolunteerName will present
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                Volunteer
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    @onclick="() => VolunteerAsync(topic)">
                                <span class="bi bi-megaphone me-1" aria-hidden="true"></span>Volunteer to present
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}