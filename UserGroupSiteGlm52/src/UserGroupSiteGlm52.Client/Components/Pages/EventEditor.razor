@page "/admin/events"
@page "/admin/events/{id:int}"
@rendermode InteractiveWebAssembly
@attribute [Authorize]

<h1 class="mb-3">@(isEdit ? "Edit event" : "Manage events")</h1>

@if (!isEdit && ManageList is not null && ManageList.Count > 0)
{
    <section class="mb-4">
        <h2 class="h5">Existing events</h2>
        <div class="list-group">
            @foreach (var evt in ManageList)
            {
                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <a href="/events/@evt.Slug" class="text-decoration-none fw-semibold">@evt.Title</a>
                        <span class="text-muted small ms-2">
                            @(evt.EventDate.HasValue ? evt.EventDate.Value.ToString("d") : "No date")
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (evt.IsPublished)
                        {
                            <span class="badge bg-success">Published</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Draft</span>
                        }
                        <a href="/admin/events/@evt.Id" class="btn btn-sm btn-outline-primary">
                            <span class="bi bi-pencil" aria-hidden="true"></span> Edit
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (Model is null || editContext is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <section>
        <h2 class="h5 mb-3">@(isEdit ? "Edit details" : "Create a new event")</h2>
        <EditForm Model="Model" EditContext="editContext" OnValidSubmit="Save" novalidate>
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-md-8">
                    <div class="form-floating mb-3">
                        <InputText id="eventTitle" class="form-control" placeholder="Title" @bind-Value="Model.Title" />
                        <label for="eventTitle">Title</label>
                        <ValidationMessage For="@(() => Model.Title)" class="text-danger small" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating mb-3">
                        <InputText id="eventSlug" class="form-control" placeholder="slug" @bind-Value="Model.Slug" @onblur="AutoSlug" />
                        <label for="eventSlug">Slug</label>
                        <ValidationMessage For="@(() => Model.Slug)" class="text-danger small" />
                    </div>
                </div>
            </div>

            <div class="form-floating mb-3">
                <InputText id="eventShort" class="form-control" placeholder="Short description" @bind-Value="Model.ShortDescription" />
                <label for="eventShort">Short description</label>
                <ValidationMessage For="@(() => Model.ShortDescription)" class="text-danger small" />
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input type="datetime-local" id="eventDate" class="form-control"
                               placeholder="Date &amp; time" @bind="Model.EventDate" @bind:format="yyyy-MM-ddTHH:mm" />
                        <label for="eventDate">Date &amp; time</label>
                        <ValidationMessage For="@(() => Model.EventDate)" class="text-danger small" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <InputText id="eventLocation" class="form-control" placeholder="Location" @bind-Value="Model.Location" />
                        <label for="eventLocation">Location</label>
                        <ValidationMessage For="@(() => Model.Location)" class="text-danger small" />
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Description (Markdown)</label>
                <MarkdownEditor @bind-Value="Model.Description" Id="eventDescription" Label="Description" />
                <ValidationMessage For="@(() => Model.Description)" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Speakers</label>
                @if (Model.SpeakerOptions.Count == 0)
                {
                    <p class="text-muted small">No speakers are available yet. Promote a user to the Speaker role first.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-1">
                        @foreach (var speaker in Model.SpeakerOptions)
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="speaker-@speaker.Id"
                                       checked="@(Model.SpeakerIds.Contains(speaker.Id))"
                                       @onchange="@(e => ToggleSpeaker(speaker.Id, e.Value is true))" />
                                <label class="form-check-label" for="speaker-@speaker.Id">
                                    @speaker.DisplayName <span class="text-muted small">@speaker.Email</span>
                                </label>
                            </div>
                        }
                    </div>
                }
                <ValidationMessage For="@(() => Model.SpeakerIds)" class="text-danger small" />
            </div>

            <div class="form-check form-switch mb-4">
                <input type="checkbox" class="form-check-input" role="switch" id="eventPublished"
                       @bind="Model.IsPublished" />
                <label class="form-check-label" for="eventPublished">
                    Published
                    <span class="text-muted small d-block">Publishing requires a description, date, location, and at least one speaker.</span>
                </label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@saving">
                    @if (saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <span class="bi bi-save me-1" aria-hidden="true"></span>
                    }
                    Save
                </button>
                <a href="/" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </EditForm>
    </section>
}