@page "/events/manage"
@rendermode InteractiveWebAssembly
@attribute [Authorize(Roles = "Admin,Speaker")]

<PageTitle>Manage Events</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Manage Events</h3>
    <a href="/events/new" class="btn btn-primary">
        <span class="bi bi-plus-circle me-1"></span>New Event
    </a>
</div>

@if (_events is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evt in _events)
                {
                    <tr>
                        <td>
                            <a href="/events/@evt.Slug">@evt.Title</a>
                        </td>
                        <td>@evt.EventDateTime.ToString("MMM d, yyyy")</td>
                        <td>@evt.Location</td>
                        <td>
                            @if (evt.IsPublished)
                            {
                                <span class="badge bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Draft</span>
                            }
                        </td>
                        <td>
                            <a href="/events/edit/@evt.Id" class="btn btn-sm btn-outline-secondary me-1">
                                <span class="bi bi-pencil"></span>
                            </a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteEvent(evt.Id)">
                                <span class="bi bi-trash"></span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
