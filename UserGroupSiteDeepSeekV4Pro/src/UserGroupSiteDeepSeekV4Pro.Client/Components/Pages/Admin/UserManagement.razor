@page "/admin/users"
@rendermode InteractiveWebAssembly
@attribute [Authorize(Roles = "Admin")]

<PageTitle>User Management</PageTitle>

<h3>User Management</h3>

@if (_users is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Admin</th>
                    <th>Speaker</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in _users)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>
                            <input type="checkbox"
                                   class="form-check-input"
                                   checked="@user.Roles.Contains("Admin")"
                                   disabled="@(user.Id == _currentUserId)"
                                   @onchange='(e) => ToggleRole(user, "Admin", (bool)(e.Value ?? false))' />
                        </td>
                        <td>
                            <input type="checkbox"
                                   class="form-check-input"
                                   checked="@user.Roles.Contains("Speaker")"
                                   @onchange='(e) => ToggleRole(user, "Speaker", (bool)(e.Value ?? false))' />
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SaveRoles(user)">
                                <span class="bi bi-check-lg me-1"></span>Save
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
