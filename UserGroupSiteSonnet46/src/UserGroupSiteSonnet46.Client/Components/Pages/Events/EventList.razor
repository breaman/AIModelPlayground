@page "/events"
@rendermode InteractiveWebAssembly
@attribute [Authorize]

<PageTitle>Events</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Events</h2>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <a href="/events/new" class="btn btn-primary">
                <span class="bi bi-plus-circle" aria-hidden="true"></span> New Event
            </a>
        </Authorized>
    </AuthorizeView>
</div>

@if (Events is null)
{
    <div>
        <p><em>Loading events...</em></p>
    </div>
}
else if (Events.Count == 0)
{
    <div>
        <p class="text-muted">No events found.</p>
    </div>
}
else
{
    <div>
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Date</th>
                    <th class="text-center">Published</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Events)
                {
                    <tr>
                        <td>@ev.Title</td>
                        <td>@(ev.EventDateTime?.ToString("MMM d, yyyy") ?? "—")</td>
                        <td class="text-center">
                            @if (ev.IsPublished)
                            {
                                <span class="badge bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Draft</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="/events/@ev.Id/edit" class="btn btn-sm btn-outline-secondary">
                                <span class="bi bi-pencil" aria-hidden="true"></span> Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
