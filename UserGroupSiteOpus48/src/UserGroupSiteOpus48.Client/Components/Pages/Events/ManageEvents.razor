@page "/events/manage"
@rendermode InteractiveWebAssembly
@attribute [Authorize(Policy = Policies.EventEditors)]

<PageTitle>Manage Events</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><span class="bi bi-calendar2-week" aria-hidden="true"></span> Manage Events</h3>
    <AuthorizeView Roles="@RoleNames.Admin">
        <a class="btn btn-primary" href="/events/new"><span class="bi bi-plus-lg" aria-hidden="true"></span> New Event</a>
    </AuthorizeView>
</div>

@if (Events is null)
{
    <p><span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Loading events…</p>
}
else if (Events.Length == 0)
{
    <p class="text-muted">No events yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Events)
                {
                    <tr>
                        <td>@ev.Title</td>
                        <td>@(ev.EventDateTime?.ToString("g") ?? "—")</td>
                        <td>
                            @if (ev.IsPublished)
                            {
                                <span class="badge text-bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Draft</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="/events/edit/@ev.Id"><span class="bi bi-pencil" aria-hidden="true"></span> Edit</a>
                            @if (ev.IsPublished)
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="/events/@ev.Slug"><span class="bi bi-eye" aria-hidden="true"></span> View</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
