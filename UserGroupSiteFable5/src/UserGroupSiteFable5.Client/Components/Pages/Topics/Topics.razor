@page "/topics"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveWebAssembly

<PageTitle>Topic Suggestions</PageTitle>

<h1>Topic Suggestions</h1>
<p class="text-body-secondary">
    Suggest topics you'd like to see at a future meeting, vote for your favorites,
    and volunteer to present.
</p>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="card-title fs-5">Suggest a topic</h2>
        <EditForm Model="NewTopic" OnValidSubmit="SubmitSuggestionAsync" FormName="topic-create">
            <DataAnnotationsValidator />
            <div class="form-floating mb-3">
                <InputText @bind-Value="NewTopic.Title" id="NewTopic.Title" class="form-control"
                           placeholder="Title" />
                <label for="NewTopic.Title">Title</label>
                <ValidationMessage For="() => NewTopic.Title" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputTextArea @bind-Value="NewTopic.Description" id="NewTopic.Description" class="form-control"
                               placeholder="Description" style="height: 6rem;" />
                <label for="NewTopic.Description">Description</label>
                <ValidationMessage For="() => NewTopic.Description" class="text-danger" />
            </div>
            <button type="submit" class="btn btn-primary" disabled="@_saving">
                <span class="bi bi-lightbulb" aria-hidden="true"></span> Suggest Topic
            </button>
        </EditForm>
    </div>
</div>

@if (TopicList is null)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Loading topics…</span>
    </div>
}
else if (TopicList.Count == 0)
{
    <p class="text-body-secondary">No suggestions yet — be the first!</p>
}
else
{
    <div class="list-group">
        @foreach (var topic in TopicList)
        {
            <div class="list-group-item py-3">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h3 class="fs-5 mb-1">@topic.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(topic.Description))
                        {
                            <p class="mb-1">@topic.Description</p>
                        }
                        <small class="text-body-secondary">
                            Suggested by @topic.SuggestedByName
                            @if (topic.VolunteerName is not null)
                            {
                                <span> · <span class="bi bi-mic-fill" aria-hidden="true"></span>
                                    @topic.VolunteerName volunteered to speak</span>
                            }
                        </small>
                    </div>
                    <div class="d-flex flex-column align-items-end gap-2">
                        <button type="button"
                                class="btn btn-sm @(topic.CurrentUserVoted ? "btn-success" : "btn-outline-success")"
                                disabled="@(topic.CurrentUserVoted || _saving)"
                                @onclick="() => VoteAsync(topic)">
                            <span class="bi bi-hand-thumbs-up" aria-hidden="true"></span>
                            @(topic.CurrentUserVoted ? "Voted" : "Vote") (@topic.VoteCount)
                        </button>
                        @if (topic.VolunteerName is null)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    disabled="@_saving"
                                    @onclick="() => VolunteerAsync(topic)">
                                <span class="bi bi-mic" aria-hidden="true"></span> Volunteer to speak
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
