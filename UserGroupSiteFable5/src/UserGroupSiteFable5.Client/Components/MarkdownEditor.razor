<div>
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link @(_showPreview ? "" : "active")" @onclick="ShowEdit">
                <span class="bi bi-pencil" aria-hidden="true"></span> Edit
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link @(_showPreview ? "active" : "")" @onclick="ShowPreview">
                <span class="bi bi-eye" aria-hidden="true"></span> Preview
            </button>
        </li>
    </ul>
    <div class="border border-top-0 rounded-bottom p-2">
        @if (_showPreview)
        {
            <div class="p-2">
                @if (string.IsNullOrWhiteSpace(Value))
                {
                    <p class="text-body-secondary fst-italic m-0">Nothing to preview yet.</p>
                }
                else
                {
                    @PreviewHtml
                }
            </div>
        }
        else
        {
            <textarea id="@Id" class="form-control border-0" rows="@Rows"
                      placeholder="Write Markdown here…"
                      value="@Value"
                      @oninput="OnInputAsync"></textarea>
        }
    </div>
</div>
