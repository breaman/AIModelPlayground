@page "/"

<PageTitle>Home</PageTitle>

@if (_events is null)
{
    <p><em>Loading…</em></p>
}
else if (_events.Count == 0)
{
    <section class="bg-light p-5 rounded mb-4 text-center">
        <h1 class="display-5">Welcome to the User Group</h1>
        <p class="lead">No events are scheduled yet. Check back soon, or suggest a topic!</p>
        <a href="/topics" class="btn btn-primary">
            <i class="bi bi-lightbulb" aria-hidden="true"></i> Suggest a topic
        </a>
    </section>
}
else
{
    var next = _events[0];

    <section class="bg-body-tertiary p-5 rounded mb-4">
        <h1 class="display-5 fw-semibold">Next up: @next.Title</h1>
        <p class="lead mb-2">
            <i class="bi bi-calendar3" aria-hidden="true"></i>
            @next.EventDateTime.ToLocalTime().ToString("dddd, MMMM d, yyyy h:mm tt")
            @if (!string.IsNullOrWhiteSpace(next.Location))
            {
                <span class="ms-3">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i> @next.Location
                </span>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(next.ShortDescription))
        {
            <p class="lead">@next.ShortDescription</p>
        }
        <a href="/events/@next.Slug" class="btn btn-primary">
            View event <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
    </section>

    @if (_events.Count > 1)
    {
        <h2 class="h4 mb-3">All upcoming events</h2>
        <ul class="list-unstyled">
            @foreach (var ev in _events.Skip(1))
            {
                <li class="card mb-3">
                    <div class="card-body">
                        <h3 class="card-title h6">
                            <a href="/events/@ev.Slug" class="text-decoration-none">@ev.Title</a>
                        </h3>
                        <p class="card-subtitle text-muted mb-2">
                            <span class="me-3">
                                <i class="bi bi-calendar3" aria-hidden="true"></i>
                                @ev.EventDateTime.ToLocalTime().ToString("dddd, MMMM d, yyyy h:mm tt")
                            </span>
                            @if (!string.IsNullOrWhiteSpace(ev.Location))
                            {
                                <span>
                                    <i class="bi bi-geo-alt" aria-hidden="true"></i> @ev.Location
                                </span>
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(ev.ShortDescription))
                        {
                            <p class="card-text">@ev.ShortDescription</p>
                        }
                        <a href="/events/@ev.Slug" class="btn btn-sm btn-outline-primary">View details</a>
                    </div>
                </li>
            }
        </ul>
    }
}
