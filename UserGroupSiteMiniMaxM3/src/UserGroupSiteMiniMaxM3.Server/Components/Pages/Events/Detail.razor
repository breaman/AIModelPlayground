@page "/events/{slug}"

<PageTitle>@(_event?.Title ?? "Event")</PageTitle>

@if (_event is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <article>
        <h1>@_event.Title</h1>
        <p class="text-muted">
            <span class="me-3">
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                @_event.EventDateTime.ToLocalTime().ToString("dddd, MMMM d, yyyy h:mm tt")
            </span>
            @if (!string.IsNullOrWhiteSpace(_event.Location))
            {
                <span>
                    <i class="bi bi-geo-alt" aria-hidden="true"></i> @_event.Location
                </span>
            }
        </p>

        @if (_event.Speakers.Count > 0)
        {
            <p>
                <i class="bi bi-mic" aria-hidden="true"></i>
                Speakers: @string.Join(", ", _event.Speakers.Select(s => s.DisplayName))
            </p>
        }

        @((MarkupString)_renderedDescription)
    </article>
}
