@page "/"
@rendermode InteractiveWebAssembly
@using UserGroupSiteNemoTron3.Shared.DTOs
@using UserGroupSiteNemoTron3.Shared.Services

<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 fw-bold">Upcoming Events</h1>
            <p class="lead text-muted">Join us for our next technical user group meeting</p>
        </div>
    </div>

    @if (Events == null)
    {
        <div class="row">
            @for (var i = 0; i < 3; i++)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body skeleton-loader">
                            <div class="skeleton-line skeleton-title"></div>
                            <div class="skeleton-line"></div>
                            <div class="skeleton-line skeleton-short"></div>
                            <div class="skeleton-line skeleton-short"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (Events.Length == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h3 class="mt-3">No Upcoming Events</h3>
            <p class="text-muted">Check back soon for new events!</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var evt in Events)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@evt.Title</h5>
                            @if (!string.IsNullOrWhiteSpace(evt.ShortDescription))
                            {
                                <p class="card-text text-muted small">@evt.ShortDescription</p>
                            }
                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    @evt.EventDateTime.ToString("MMMM d, yyyy 'at' h:mm tt")
                                </small>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(evt.Location))
                            {
                                <div class="mb-2">
                                    <small class="text-muted">
                                        <i class="bi bi-geo-alt me-1"></i>
                                        @evt.Location
                                    </small>
                                </div>
                            }
                            @if (evt.Speakers.Length > 0)
                            {
                                <div class="mb-2">
                                    <small class="text-muted">
                                        <i class="bi bi-person-badge me-1"></i>
                                        @string.Join(", ", evt.Speakers.Select(s => s.FullName))
                                    </small>
                                </div>
                            }
                            <div class="mt-auto">
                                <a href="/event/@evt.Slug" class="btn btn-primary w-100">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .skeleton-loader {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: skeleton-loading 1.5s infinite;
        border-radius: 4px;
    }
    .skeleton-line {
        height: 1rem;
        margin-bottom: 0.5rem;
    }
    .skeleton-title {
        height: 1.5rem;
        width: 80%;
    }
    .skeleton-short {
        width: 60%;
    }
    @@keyframes skeleton-loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
</style>