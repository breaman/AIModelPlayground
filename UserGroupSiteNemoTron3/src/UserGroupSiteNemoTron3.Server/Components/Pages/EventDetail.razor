@page "/event/{Slug}"
@rendermode InteractiveWebAssembly
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using UserGroupSiteNemoTron3.Shared.DTOs
@using UserGroupSiteNemoTron3.Shared.Services
@using Microsoft.AspNetCore.Components.Authorization

@if (Event == null)
{
    <div class="container py-5">
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
}
else
{
    <div class="container py-5">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h1 class="display-5 fw-bold">@Event.Title</h1>
                        <div class="text-muted mt-2">
                            <i class="bi bi-calendar-event me-1"></i>
                            @Event.EventDateTime.ToString("MMMM d, yyyy 'at' h:mm tt")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Event.Location))
                        {
                            <div class="text-muted mt-1">
                                <i class="bi bi-geo-alt me-1"></i>
                                @Event.Location
                            </div>
                        }
                    </div>
                    @if (CanEdit)
                    {
                        <a href="/admin/events/edit/@Event.Id" class="btn btn-outline-primary">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                    }
                </div>

                @if (Event.Speakers.Length > 0)
                {
                    <div class="mb-4">
                        <h6 class="text-muted">Speakers</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var speaker in Event.Speakers)
                            {
                                <span class="badge bg-primary text-bg-primary">
                                    @speaker.FullName @(speaker.IsPrimary ? "(Primary)" : "")
                                </span>
                            }
                        </div>
                    </div>
                }

                <hr class="my-4" />

                @if (!string.IsNullOrWhiteSpace(Event.Description))
                {
                    <div class="markdown-content">
                        @((MarkupString)RenderedDescription)
                    </div>
                }
                else
                {
                    <p class="text-muted">No description available.</p>
                }
            </div>
        </div>
    </div>
}