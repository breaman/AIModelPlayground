@page "/admin/users"
@rendermode InteractiveWebAssembly
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "AdminOnly")]
@using UserGroupSiteNemoTron3.Shared.DTOs
@using UserGroupSiteNemoTron3.Shared.Services
@using Microsoft.AspNetCore.Components.Authorization

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">User Management</h1>
    </div>

    @if (Users == null)
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Member Since</th>
                        <th>Admin</th>
                        <th>Speaker</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < 5; i++)
                    {
                        <tr>
                            <td><div class="skeleton-loader skeleton-title"></div></td>
                            <td><div class="skeleton-loader"></div></td>
                            <td><div class="skeleton-loader skeleton-short"></div></td>
                            <td><div class="skeleton-loader" style="width: 24px; height: 24px;"></div></td>
                            <td><div class="skeleton-loader" style="width: 24px; height: 24px;"></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Users.Length == 0)
    {
        <div class="text-center py-5">
            <i class="bi bi-people display-1 text-muted"></i>
            <h3 class="mt-3">No Users Found</h3>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Member Since</th>
                        <th class="text-center">Admin</th>
                        <th class="text-center">Speaker</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Users)
                    {
                        var isCurrentUser = user.Id == CurrentUserId;
                        <tr>
                            <td>
                                <strong>@(user.FirstName + " " + user.LastName)</strong>
                                @if (!string.IsNullOrWhiteSpace(user.UserName))
                                {
                                    <br />
                                    <small class="text-muted">@user.UserName</small>
                                }
                            </td>
                            <td>@user.Email</td>
                            <td>@user.MemberSince.ToString("MMM d, yyyy")</td>
                            <td class="text-center">
                                <InputCheckbox @bind-Value="@(user.IsAdmin)"
                                               disabled="@isCurrentUser"
                                               class="form-check-input mx-auto"
                                               @onchange="@(e => UpdateUserRole(user.Id, !user.IsAdmin, user.IsSpeaker))" />
                                @if (isCurrentUser)
                                {
                                    <small class="text-muted d-block">(You)</small>
                                }
                            </td>
                            <td class="text-center">
                                <InputCheckbox @bind-Value="@(user.IsSpeaker)"
                                               class="form-check-input mx-auto"
                                               @onchange="@(e => UpdateUserRole(user.Id, user.IsAdmin, !user.IsSpeaker))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .skeleton-loader {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: skeleton-loading 1.5s infinite;
        border-radius: 4px;
    }
    .skeleton-title {
        height: 1.25rem;
        width: 80%;
    }
    .skeleton-short {
        width: 60%;
    }
    @@keyframes skeleton-loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
</style>