@page "/admin/events"
@attribute [Authorize(Policy = ApplicationPolicies.EditEvents)]
@rendermode InteractiveWebAssembly

<PageTitle>Manage Events</PageTitle>

<section class="py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 mb-0">Manage Events</h1>
            <AuthorizeView Policy="@ApplicationPolicies.CreateEvents">
                <a class="btn btn-primary" href="/admin/events/new">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> New Event
                </a>
            </AuthorizeView>
        </div>

        @if (Events is null)
        {
            <div class="alert alert-info">Loading events...</div>
        }
        else if (Events.Count == 0)
        {
            <div class="alert alert-secondary">No editable events are available.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                    <tr>
                        <th>Title</th>
                        <th>Date</th>
                        <th>Speakers</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Events)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@(item.StartsAt?.ToLocalTime().ToString("g") ?? "Draft")</td>
                            <td>@string.Join(", ", item.Speakers)</td>
                            <td><span class="badge @(item.IsPublished ? "text-bg-success" : "text-bg-secondary")">@(item.IsPublished ? "Published" : "Draft")</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="/admin/events/@item.Id/edit">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
