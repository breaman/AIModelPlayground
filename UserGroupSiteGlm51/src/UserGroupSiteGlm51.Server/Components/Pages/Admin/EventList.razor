@page "/admin/events"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using UserGroupSiteGlm51.Data.Models

<h1 class="mb-4">Manage Events</h1>

<div class="mb-3">
    <a href="/admin/events/new" class="btn btn-primary">
        <span class="bi bi-plus-circle" aria-hidden="true"></span> Create New Event
    </a>
</div>

@if (AllEvents is null)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!AllEvents.Any())
{
    <div class="alert alert-info">
        No events found. Create your first event!
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Slug</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Published</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in AllEvents)
                {
                    <tr>
                        <td>@ev.Title</td>
                        <td><code>@ev.Slug</code></td>
                        <td>@(ev.EventDate?.LocalDateTime.ToString("MMM dd, yyyy") ?? "TBD")</td>
                        <td>@(ev.Location ?? "TBD")</td>
                        <td>
                            @if (ev.IsPublished)
                            {
                                <span class="badge bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Draft</span>
                            }
                        </td>
                        <td>
                            <a href="/admin/events/@ev.Id/edit" class="btn btn-sm btn-outline-primary">
                                <span class="bi bi-pencil" aria-hidden="true"></span> Edit
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteEvent(ev.Id)">
                                <span class="bi bi-trash" aria-hidden="true"></span> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}