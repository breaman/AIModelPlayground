@page "/admin/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<h1 class="mb-4">Manage Users</h1>

@if (AllUsers is null)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!AllUsers.Any())
{
    <div class="alert alert-info">No users found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in AllUsers)
                {
                    <tr>
                        <td>@user.FirstName @user.LastName</td>
                        <td>@user.Email</td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge @(role == AdminRole ? "bg-danger" : role == SpeakerRole ? "bg-info" : "bg-secondary") me-1">@role</span>
                            }
                        </td>
                        <td>
                            @if (!user.Roles.Contains(AdminRole))
                            {
                                <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => AddToRole(user.Id, AdminRole)">
                                    <span class="bi bi-shield-plus" aria-hidden="true"></span> Make Admin
                                </button>
                            }
                            @if (!user.Roles.Contains(SpeakerRole))
                            {
                                <button class="btn btn-sm btn-outline-info me-1" @onclick="() => AddToRole(user.Id, SpeakerRole)">
                                    <span class="bi bi-mic-plus" aria-hidden="true"></span> Make Speaker
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => RemoveFromRole(user.Id, SpeakerRole)">
                                    <span class="bi bi-mic-minus" aria-hidden="true"></span> Remove Speaker
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}