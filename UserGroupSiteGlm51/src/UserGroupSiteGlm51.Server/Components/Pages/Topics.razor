@page "/topics"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using UserGroupSiteGlm51.Data.Models

<h1 class="mb-4">Topic Suggestions</h1>

<div class="mb-3">
    <a href="/topics/new" class="btn btn-primary">
        <span class="bi bi-plus-circle" aria-hidden="true"></span> Suggest a Topic
    </a>
</div>

@if (TopicList is null)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!TopicList.Any())
{
    <div class="alert alert-info">
        No topic suggestions yet. Be the first to suggest one!
    </div>
}
else
{
    @foreach (var topic in TopicList)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h5 class="card-title">@topic.Title</h5>
                        <small class="text-muted">
                            Suggested by @topic.SuggestedBy?.FirstName @topic.SuggestedBy?.LastName
                        </small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary">
                            <span class="bi bi-hand-thumbs-up" aria-hidden="true"></span>
                            @topic.Votes.Count
                        </span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(topic.Description))
                {
                    <div class="mt-2">
                        @((MarkupString)topic.Description)
                    </div>
                }

                <div class="mt-3 d-flex gap-2 align-items-center flex-wrap">
                    @{
                        var hasVoted = topic.Votes.Any(v => v.UserId == CurrentUserId);
                    }
                    @if (hasVoted)
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => UnvoteTopic(topic.Id)">
                            <span class="bi bi-hand-thumbs-up-fill" aria-hidden="true"></span> Voted
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => VoteTopic(topic.Id)">
                            <span class="bi bi-hand-thumbs-up" aria-hidden="true"></span> Vote
                        </button>
                    }

                    @if (topic.VolunteerId.HasValue)
                    {
                        if (topic.VolunteerId == CurrentUserId)
                        {
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => UnvolunteerTopic(topic.Id)">
                                <span class="bi bi-x-circle" aria-hidden="true"></span> Unvolunteer
                            </button>
                            <span class="badge bg-success">
                                <span class="bi bi-mic" aria-hidden="true"></span> You are presenting
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-info">
                                <span class="bi bi-mic" aria-hidden="true"></span> @topic.Volunteer?.FirstName @topic.Volunteer?.LastName is presenting
                            </span>
                        }
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-success" @onclick="() => VolunteerTopic(topic.Id)">
                            <span class="bi bi-mic" aria-hidden="true"></span> Volunteer to Present
                        </button>
                    }
                </div>
            </div>
        </div>
    }
}