@page "/events/new"
@page "/events/{Id:int}/edit"
@rendermode InteractiveWebAssembly
@attribute [Authorize(Policy = PolicyNames.SpeakerOrAdmin)]

<PageTitle>@(IsNew ? "New meeting" : "Edit meeting")</PageTitle>

@if (NotFound)
{
    <h1 class="h3">Meeting not available</h1>
    <p class="text-body-secondary">
        This meeting does not exist, or you are not one of its editors.
    </p>
    <a class="btn btn-outline-secondary" href="/events/manage">
        <span class="bi bi-arrow-left" aria-hidden="true"></span> Back to manage meetings
    </a>
}
else if (Model is null)
{
    <div class="d-flex align-items-center gap-2 text-body-secondary" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Loading meeting…</span>
    </div>
}
else
{
    <h1 class="h2 mb-4">@(IsNew ? "New meeting" : "Edit meeting")</h1>

    <EditForm Model="Model" OnValidSubmit="SaveAsync" FormName="event-edit">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" role="alert" />

        <div class="row">
            <div class="col-lg-8">
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Model.Title"
                               @bind-Value:after="OnTitleChanged"
                               @onblur="OnTitleBlurAsync"
                               id="Model.Title"
                               class="form-control"
                               placeholder="Meeting title" />
                    <label for="Model.Title">Title</label>
                    <ValidationMessage For="() => Model.Title" class="text-danger" />
                </div>

                <div class="form-floating mb-3">
                    <InputText @bind-Value="Model.Slug"
                               id="Model.Slug"
                               class="form-control"
                               placeholder="meeting-title" />
                    <label for="Model.Slug">Slug</label>
                    <div class="form-text">The address this meeting appears at: /events/@(Model.Slug)</div>
                    <ValidationMessage For="() => Model.Slug" class="text-danger" />
                </div>

                <div class="form-floating mb-3">
                    <InputTextArea @bind-Value="Model.ShortDescription"
                                   id="Model.ShortDescription"
                                   class="form-control"
                                   style="height: 6rem"
                                   placeholder="One-line teaser" />
                    <label for="Model.ShortDescription">Short description</label>
                    <ValidationMessage For="() => Model.ShortDescription" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="Model.Description">Description</label>
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button type="button"
                                    class="nav-link @(IsPreviewing ? "" : "active")"
                                    role="tab"
                                    aria-selected="@(!IsPreviewing)"
                                    @onclick="() => IsPreviewing = false">
                                <span class="bi bi-pencil" aria-hidden="true"></span> Edit
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button type="button"
                                    class="nav-link @(IsPreviewing ? "active" : "")"
                                    role="tab"
                                    aria-selected="@IsPreviewing"
                                    @onclick="() => IsPreviewing = true">
                                <span class="bi bi-eye" aria-hidden="true"></span> Preview
                            </button>
                        </li>
                    </ul>
                    <div class="border border-top-0 rounded-bottom p-3">
                        @if (IsPreviewing)
                        {
                            @if (string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <p class="text-body-secondary mb-0">Nothing to preview yet.</p>
                            }
                            else
                            {
                                <article class="markdown-body">
                                    @((MarkupString)MarkdownRenderer.ToHtml(Model.Description))
                                </article>
                            }
                        }
                        else
                        {
                            <InputTextArea @bind-Value="Model.Description"
                                           id="Model.Description"
                                           class="form-control font-monospace"
                                           style="height: 18rem"
                                           placeholder="Markdown description" />
                            <div class="form-text">Markdown is supported. Raw HTML is escaped.</div>
                        }
                        <ValidationMessage For="() => Model.Description" class="text-danger" />
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="form-floating mb-3">
                    <InputDate @bind-Value="Model.EventDateTime"
                               Type="InputDateType.DateTimeLocal"
                               id="Model.EventDateTime"
                               class="form-control"
                               placeholder="Date and time" />
                    <label for="Model.EventDateTime">Date and time</label>
                    <ValidationMessage For="() => Model.EventDateTime" class="text-danger" />
                </div>

                <div class="form-floating mb-3">
                    <InputText @bind-Value="Model.Location"
                               id="Model.Location"
                               class="form-control"
                               placeholder="Venue and room" />
                    <label for="Model.Location">Location</label>
                    <ValidationMessage For="() => Model.Location" class="text-danger" />
                </div>

                <fieldset class="mb-3">
                    <legend class="form-label fs-6">Speakers</legend>
                    @if (AvailableSpeakers is null)
                    {
                        <p class="text-body-secondary small mb-0">Loading speakers…</p>
                    }
                    else if (AvailableSpeakers.Count == 0)
                    {
                        <p class="text-body-secondary small mb-0">
                            No members hold the Speaker role yet. An administrator can grant it from
                            the members screen.
                        </p>
                    }
                    else
                    {
                        <div class="border rounded p-2" style="max-height: 14rem; overflow-y: auto;">
                            @foreach (var speaker in AvailableSpeakers)
                            {
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="@($"speaker-{speaker.UserId}")"
                                           checked="@Model.SpeakerUserIds.Contains(speaker.UserId)"
                                           @onchange="e => ToggleSpeaker(speaker.UserId, e.Value is true)" />
                                    <label class="form-check-label" for="@($"speaker-{speaker.UserId}")">
                                        @speaker.DisplayName
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    <ValidationMessage For="() => Model.SpeakerUserIds" class="text-danger" />
                </fieldset>

                <div class="form-check form-switch mb-2">
                    <InputCheckbox @bind-Value="Model.IsPublished"
                                   id="Model.IsPublished"
                                   class="form-check-input" />
                    <label class="form-check-label" for="Model.IsPublished">Published</label>
                </div>

                @if (MissingForPublish() is { Count: > 0 } missing)
                {
                    <div class="alert alert-warning py-2 px-3 small" role="status">
                        <span class="bi bi-exclamation-triangle" aria-hidden="true"></span>
                        Not ready to publish — still needs @string.Join(", ", missing).
                    </div>
                }

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        Save
                    </button>
                    <a class="btn btn-outline-secondary" href="/events/manage">Cancel</a>
                </div>
            </div>
        </div>
    </EditForm>
}
