@page "/events/manage"
@rendermode InteractiveWebAssembly
@attribute [Authorize(Policy = PolicyNames.SpeakerOrAdmin)]

<PageTitle>Manage meetings</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Manage meetings</h1>
        <p class="text-body-secondary mb-0">Drafts and published meetings you can edit.</p>
    </div>
    <AuthorizeView Roles="@RoleNames.Admin">
        <a class="btn btn-primary" href="/events/new">
            <span class="bi bi-plus-lg" aria-hidden="true"></span> New meeting
        </a>
    </AuthorizeView>
</div>

@if (Events is null)
{
    <div class="d-flex align-items-center gap-2 text-body-secondary" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Loading meetings…</span>
    </div>
}
else if (Events.Count == 0)
{
    <div class="card border-0 bg-body-tertiary">
        <div class="card-body text-center py-5">
            <p class="display-6 mb-2" aria-hidden="true"><span class="bi bi-calendar-plus"></span></p>
            <h2 class="h5">Nothing to manage yet</h2>
            <p class="text-body-secondary mb-0">
                Meetings you are assigned to as a speaker will appear here.
            </p>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <caption class="visually-hidden">Meetings you can edit</caption>
            <thead>
                <tr>
                    <th scope="col">Title</th>
                    <th scope="col">When</th>
                    <th scope="col">Where</th>
                    <th scope="col">Speakers</th>
                    <th scope="col">Status</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var meeting in Events)
                {
                    <tr>
                        <th scope="row" class="fw-semibold">@meeting.Title</th>
                        <td>@(meeting.EventDateTime?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "—")</td>
                        <td>@(string.IsNullOrWhiteSpace(meeting.Location) ? "—" : meeting.Location)</td>
                        <td>
                            @(meeting.Speakers.Count == 0
                                ? "—"
                                : string.Join(", ", meeting.Speakers.Select(x => x.DisplayName)))
                        </td>
                        <td>
                            @if (meeting.IsPublished)
                            {
                                <span class="badge text-bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Draft</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               href="@($"/events/{meeting.Id}/edit")"
                               aria-label="@($"Edit {meeting.Title}")">
                                <span class="bi bi-pencil" aria-hidden="true"></span> Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
